MODE=mock
API_TOKEN=change-me
DASHBOARD_PORT=8080
SANDBOX_PORT=8090
MAX_CONCURRENT_BROWSERS=2

# LLM tiers: mock | nebius | bedrock | azure | meta | openai_compat | ollama
LLM_FAST_PROVIDER=mock
LLM_STRONG_PROVIDER=mock
LLM_VISION_PROVIDER=mock
LLM_REPAIR_PROVIDER=mock
COUNCIL_PROVIDERS=mock_a,mock_b,mock_c
COUNCIL_VOTERS=mock_a,mock_b,mock_c,mock_d,mock_e,mock_f

# Nebius (OpenAI-compatible) — copy the base URL from Nebius docs
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_FAST_MODEL=

# AWS Bedrock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=

# Azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Meta Model API (OpenAI-compatible)
META_API_KEY=
META_BASE_URL=
META_MODEL=

# Generic OpenAI-compatible (OpenRouter and similar)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# Ollama / Gemma
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=

# STT: mock | assemblyai | azure
STT_PROVIDER=mock
ASSEMBLYAI_API_KEY=

# Search: mock | tavily
SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# Wallet: mock | solana_devnet
WALLET_PROVIDER=mock
SOLANA_RPC_URL=https://api.devnet.solana.com
WALLET_KEYPAIR_PATH=
WALLET_DAILY_LIMIT_SOL=0.5
WALLET_PER_TX_LIMIT_SOL=0.1

# Channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TO=

# Demo account placeholders (sandbox only, not real secrets)
SHOP_EMAIL=demo@grasshopper.local
SHOP_PASSWORD=demo-password
AI_ALPHA_EMAIL=demo@grasshopper.local
AI_ALPHA_PASSWORD=demo-password
AI_BETA_EMAIL=demo@grasshopper.local
AI_BETA_PASSWORD=demo-password

# Hard ceilings. The router reserves catalog token price before each call.
BUDGET_USD_DAILY=0.50
BUDGET_USD_PER_RUN=0.05
# Bedrock stays off until this is 1, even if AWS keys are filled in.
ALLOW_BEDROCK=0
# Empty keeps the code allowlist. A value can only narrow it.
REAL_SITES_ALLOWLIST=
REAL_SITE_DELAY_SEC=1

# auto | playwright | http
BROWSER_DRIVER=auto
# Override when the sandbox is not on SANDBOX_PORT (tests do this)
SANDBOX_BASE_URL=
SANDBOX_DELAY_MIN_MS=100
SANDBOX_DELAY_MAX_MS=800
APPROVAL_TIMEOUT_SEC=1800
GRASSHOPPER_EMBED_SANDBOX=1
GRASSHOPPER_DB=
GRASSHOPPER_RUNS_DIR=
GRASSHOPPER_DATA_DIR=
